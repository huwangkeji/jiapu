DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jiapu_czkree_com
DB_USER=jiapu_czkree_com
DB_PASS=eaSZ8iaYt2necRWx
DB_CHARSET=utf8mb4

SITE_URL=https://jiapu.czkree.com
SITE_NAME=族谱传承
SITE_VERSION=1.0.0

UPLOAD_MAX_SIZE=5242880
SESSION_LIFETIME=7200
PAGE_SIZE=15

# ── 管理员密码重置应急通道（默认关闭！启用后请务必改回 false）──
RESET_ADMIN_ENABLED=false
RESET_ADMIN_KEY=c9629df84d66cb2bfe3927ae
RESET_ADMIN_IP=173.242.122.73,::1

# ── UCenter 2.0 账号互通（后台「UCenter 互通」页面可配置，此处为默认值）──
UC_ENABLED=false
UC_API=
UC_IP=
UC_KEY=
UC_APPID=0
UC_CONNECT=mysql

# ── CSP 额外放行的脚本域名（UCenter 同步登录需要加载其他应用的 <script src>）──
